    <select id="getAll" resultType="io.okkio.domain.User">
        select * from user
    </select>

    <resultMap id="UserMapping" type="io.okkio.dto.response.UserDtoResponse">
        <result property="roleName" column="ROLE_NAME"/>
        <result property="username" column="USERNAME"/>
        <result property="email" column="EMAIL"/>
        <result property="id" column="ID"/>
    </resultMap>
    <select id="getUserById" parameterType="Long" resultMap="UserMapping">
        select u.USERNAME, u.EMAIL, u.ID, r.ROLE_NAME from user u
        inner join role r on u.role_id = r.id
        where u.id = #{id}
    </select>

