    <update id="updateLocationByIds">
        update okkio.location cd
        set cd.status = #{status}
        <if test="name != null">
            ,cd.name = #{name}
        </if>
        <if test="address != null">
            ,cd.address = #{address}
        </if>
        <if test="phone != null">
            ,cd.phone = #{phone}
        </if>
        <if test="title != null">
            ,cd.title = #{title}
        </if>
        <if test="description != null">
            ,cd.description = #{description}
        </if>
        <if test="openTime != null">
            ,cd.open_time = #{openTime}
        </if>
        <if test="openDay != null">
            ,cd.open_day = #{openDay}
        </if>
        <if test="conceptStore != null">
            ,cd.concept_store = #{conceptStore}
        </if>
        <if test="images != null">
            ,cd.images = #{images}
        </if>
        where 1=1
        <if test="ids > -1">
            and cd.id = #{ids}
        </if>
    </update>

</mapper>
